# deps & build output
node_modules/
dist/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Downloaded assets are NOT committed - they are regenerated by the fetch
# scripts (`npm run assets`). This keeps the repo small and avoids
# redistributing third-party imagery. Provenance files ARE committed.
# ---------------------------------------------------------------------------

# Poly Haven textures / HDRI (CC0, ~16 MB) -> npm run fetch:textures
public/textures/*
!public/textures/.gitkeep
public/hdri/*
!public/hdri/.gitkeep

# Wikimedia Commons reference photos (CC BY-SA / CC BY / PD, ~7.7 MB)
# -> npm run fetch:commons. Attribution is kept; the images are not mirrored.
reference/commons/*
!reference/commons/.gitkeep
!reference/commons/ATTRIBUTION.md

# Generated contact sheet
reference/index.html

# Your own private reference photos - never committed
reference/mine/*
!reference/mine/.gitkeep

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
